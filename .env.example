# AgroVision-Mine Environment Configuration

# Database Settings
# For local development with SQLite (default):
DB_TYPE=sqlite
DB_SQLITE_PATH=database/agrovision_warehouse.db

# For PostgreSQL deployment (uncomment when using PostgreSQL):
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=agrovision_dw
# DB_USER=postgres
# DB_PASSWORD=postgres

# Environment
APP_ENV=development
LOG_LEVEL=INFO

# Image Processing Defaults
IMAGE_RESIZE_WIDTH=256
IMAGE_RESIZE_HEIGHT=256
DUPLICATE_PHASH_THRESHOLD=5
BLUR_LAPLACIAN_THRESHOLD=100.0
